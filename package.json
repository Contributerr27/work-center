{
  "name": "work-center",
  "version": "0.1.0",
  "description": "A visual morning overview of GitHub, Jira, Slack, meetings and suggested work",
  "license": "MIT",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "web": "node src/server.js --open",
    "serve": "node src/server.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac dir",
    "demo": "node demo/run.js",
    "demo:app": "node demo/run.js --app",
    "screenshots": "node demo/run.js --no-open --shots"
  },
  "build": {
    "appId": "io.github.sslugic.workcenter",
    "productName": "Work Center",
    "files": [
      "build/icon.*",
      "build/icon.png",
      "build/tray*.png",
      "build/icons/*.png",
      "config.json",
      "main.js",
      "prompts/**",
      "public/**",
      "src/**",
      "theme-packs/**",
      "THEMES.md"
    ],
    "mac": {
      "target": "dir",
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSCameraUsageDescription": "Work Center uses the camera for video calls you join in its meeting panel.",
        "NSMicrophoneUsageDescription": "Work Center uses the microphone for video calls you join in its meeting panel."
      }
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "icon": "build/icon.png",
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "afterPack": "./src/terminal.js"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.0.12"
  },
  "productName": "Work Center",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "ws": "^8.23.0"
  }
}
